{
  "info": {
    "name": "Fuel Route Optimization API",
    "description": "API that computes optimal fuel stops for US road trips. Given a start and finish location, returns a full route with geometry, fuel stops selected by greedy price-minimization, and a cost summary.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "New York, NY → Los Angeles, CA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/route/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "v1", "route", ""]
        },
        "description": "Transcontinental route from New York City to Los Angeles. Tests full pipeline: geocoding, OSRM routing, station corridor filtering, and greedy optimization."
      }
    },
